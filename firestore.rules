rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);

      // User's applications subcollection
      match /applications/{applicationId} {
        allow read, write: if isValidId(userId) && isOwner(userId) && isValidId(applicationId);
      }

      // User's chat messages subcollection
      match /chats/{chatId} {
        allow read, write: if isValidId(userId) && isOwner(userId) && isValidId(chatId);
      }

      // User's AI evaluations & benchmark suites subcollection
      match /evaluations/{evaluationId} {
        allow read, write: if isValidId(userId) && isOwner(userId) && isValidId(evaluationId);
      }

      // User's notification and reminder preferences
      match /settings/{settingId} {
        allow read, write: if isValidId(userId) && isOwner(userId) && isValidId(settingId);
      }

      // User's scheduled reminder delivery logs
      match /reminderLogs/{logId} {
        allow read, write: if isValidId(userId) && isOwner(userId) && isValidId(logId);
      }
    }

    // Health check or connection test doc
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
