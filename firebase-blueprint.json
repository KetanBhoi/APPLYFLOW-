{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and career search settings",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user ID"
        },
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "displayName": {
          "type": "string",
          "description": "User's full name or screen name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "currentRole": {
          "type": "string",
          "description": "Current or target role"
        },
        "targetSalary": {
          "type": "string",
          "description": "Target compensation range"
        },
        "location": {
          "type": "string",
          "description": "Preferred work location"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 update timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "An opportunity tracked in the user's pipeline",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique application ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "company": {
          "type": "string",
          "description": "Company name"
        },
        "role": {
          "type": "string",
          "description": "Role or position title"
        },
        "location": {
          "type": "string",
          "description": "Work location or remote status"
        },
        "salary": {
          "type": "string",
          "description": "Stated or target compensation"
        },
        "status": {
          "type": "string",
          "description": "Pipeline stage status",
          "enum": ["wishlist", "applied", "interviewing", "offer", "rejected"]
        },
        "priority": {
          "type": "string",
          "description": "Target priority",
          "enum": ["low", "medium", "high"]
        },
        "appliedDate": {
          "type": "string",
          "description": "Date application was submitted"
        },
        "followUpDate": {
          "type": "string",
          "description": "Date for next follow-up"
        },
        "interviewDate": {
          "type": "string",
          "description": "Scheduled interview date/time"
        },
        "notes": {
          "type": "string",
          "description": "User notes and research"
        },
        "fitScore": {
          "type": "number",
          "description": "AI calculated ATS match percentage"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["id", "userId", "company", "role", "status", "priority"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in multi-turn Gemini career coach chat",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model", "system"]
        },
        "text": {
          "type": "string",
          "description": "Message content"
        },
        "modelUsed": {
          "type": "string",
          "description": "Gemini model used"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["id", "role", "text", "timestamp"]
    },
    "AIEvaluationRecord": {
      "title": "AIEvaluationRecord",
      "description": "AI model evaluation benchmark and structured rubric scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "promptTitle": { "type": "string" },
        "testPrompt": { "type": "string" },
        "taskCategory": { "type": "string" },
        "results": { "type": "object" },
        "rubricScores": { "type": "object" },
        "evaluatorNotes": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "promptTitle", "testPrompt", "timestamp"]
    },
    "ReminderSettings": {
      "title": "ReminderSettings",
      "description": "User preferences for automated email follow-up reminders and digests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "dailySummaryEnabled": { "type": "boolean" },
        "weeklySummaryEnabled": { "type": "boolean" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "both", "off"] },
        "preferredTime": { "type": "string" },
        "leadDaysBeforeFollowUp": { "type": "number" },
        "lastSentAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["recipientEmail", "frequency"]
    },
    "ReminderLog": {
      "title": "ReminderLog",
      "description": "Record of a sent or scheduled email reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "subject": { "type": "string" },
        "summary": { "type": "string" },
        "followUpItemsCount": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "recipientEmail", "subject", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private profile for each authenticated user"
    },
    "/users/{userId}/applications/{applicationId}": {
      "schema": "JobApplication",
      "description": "Job applications tracked by the user"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Chat messages and advice history"
    },
    "/users/{userId}/evaluations/{evaluationId}": {
      "schema": "AIEvaluationRecord",
      "description": "AI model evaluations and benchmark reports"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "ReminderSettings",
      "description": "User notification and reminder configuration"
    },
    "/users/{userId}/reminderLogs/{logId}": {
      "schema": "ReminderLog",
      "description": "Delivery history of scheduled follow-up email digests"
    }
  }
}
